GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Thinking level for scoring calls: minimal | low | medium | high (default low).
# Gemini 3 thinks by default, which adds latency. Leave empty to omit the
# thinking config (required if GEMINI_MODEL is set back to a 2.x model).
GEMINI_THINKING_LEVEL=low
# Max concurrent Gemini batch calls (default 4). 20 photos = 3 batches, so
# values above 3 have no effect at the current photo limit.
MAX_CONCURRENCY=4
